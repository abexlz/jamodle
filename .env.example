# Register for API key at:
# https://krdict.korean.go.kr/kor/openApi/openApiRegister

KOREAN_DICTIONARY_API_KEY=your_32_character_hex_key_here

# Pixabay (Word Chain answer illustrations — vector images, primary source)
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# Pexels (Word Chain answer photos — optional fallback if Pixabay is unset/unavailable)
# https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Optional: protect the word-import admin page (?token=...)
ADMIN_IMPORT_TOKEN=choose-a-secret-token

# Local dev server port
PORT=3000
